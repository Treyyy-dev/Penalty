rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each player's saved progress: only they can read or change it
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // messages left for a player while they were offline
      match /inbox/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && get(/databases/$(database)/documents/names/$(request.resource.data.from)).data.uid == request.auth.uid;
      }
    }
    // the developer: whoever claimed the game first from the in-game DEV screen
    function isDev() {
      return request.auth != null
        && get(/databases/$(database)/documents/config/owner).data.uid == request.auth.uid;
    }
    match /config/owner {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    // the dev key (stored scrambled) and what has been released to players
    match /config/dev { allow read, write: if isDev(); }
    // the bot players, saved once from the studio so every phone has the same list
    match /config/bots {
      allow read: if true;
      allow write: if isDev();
    }
    match /config/release {
      allow read: if true;
      allow write: if isDev();
    }
    // the public leaderboard entry for each signed-in player
    match /lb/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.n is string && request.resource.data.n.size() <= 14
        && request.resource.data.rt is int && request.resource.data.rf is int;
    }
    // one document per player name, so a name can only belong to one account
    match /names/{name} {
      allow read: if request.auth != null;
      // players claim their own name; the developer can also save the bot players' names
      allow create: if request.auth != null && (request.resource.data.uid == request.auth.uid || isDev());
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
