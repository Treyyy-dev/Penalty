rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each player's saved progress: only they can read or change it
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // messages left for a player while they were offline
      match /inbox/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && get(/databases/$(database)/documents/names/$(request.resource.data.from)).data.uid == request.auth.uid;
      }
    }
    // one document per player name, so a name can only belong to one account
    match /names/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
